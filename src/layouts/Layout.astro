---
import "../styles/globals.css";

export interface Props {
  title?: string;
  description?: string;
}

const { title = "Live Leads — Captura leads de TikTok Live en tiempo real", description = "Monitorea transmisiones de TikTok Live, clasifica leads con IA y captura clientes potenciales en tiempo real." } = Astro.props;
---

<!DOCTYPE html>
<html lang="es" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    {title && <title>{title}</title>}
  </head>
  <body class="antialiased" style="background-color: #0b0f1a;">
    <slot />
  </body>
</html>

---
import "../styles/globals.css";

export interface Props {
  title?: string;
  description?: string;
}

const { title = "Live Leads — Captura leads de TikTok Live en tiempo real", description = "Monitorea transmisiones de TikTok Live, clasifica leads con IA y captura clientes potenciales en tiempo real." } = Astro.props;
---

<!DOCTYPE html>
<html lang="es" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <link rel="preload" href="/video/demo.mp4" as="video" type="video/mp4" />
    {title && <title>{title}</title>}
  </head>
  <body class="antialiased" style="background-color: #0b0f1a;">
    <slot />
  </body>
</html>

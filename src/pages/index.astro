---
import Layout from "@/layouts/Layout.astro";
import { AppProviders } from "@/components/AppProviders";
import Navbar from "@/components/landing/navbar";
import HeroSection from "@/components/landing/hero";
import FunnelAnimation from "@/components/landing/funnel-animation";
import VideoSection from "@/components/landing/video-section";
import FeaturesSection from "@/components/landing/features";
import CtaSection from "@/components/landing/CtaSection.astro";
import Footer from "@/components/landing/Footer.astro";
---

<Layout>
  <Fragment slot="head">
    <link rel="preload" href="/video/demo.mp4" as="fetch" type="video/mp4" crossorigin="anonymous" />
  </Fragment>
  <AppProviders client:load>
    <div class="min-h-screen flex flex-col">
      <Navbar client:load />
      <main class="flex-1">
        <HeroSection client:load />
        <FunnelAnimation client:visible />
        <VideoSection client:load />
        <FeaturesSection client:visible />
        <CtaSection />
      </main>
      <Footer />
    </div>
  </AppProviders>
</Layout>

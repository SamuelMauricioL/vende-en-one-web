---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="Live Leads">
  <div class="min-h-screen flex flex-col items-center justify-center gap-4" style="background-color: #0b0f1a;">
    <h1 class="text-4xl font-extrabold text-white">Live Leads</h1>
    <p class="text-white/60">Captura leads de TikTok Live en tiempo real</p>
    <a href="/sign-in" class="px-6 py-3 rounded-lg font-semibold text-white" style="background: linear-gradient(135deg, #fe2c55, #e8254a);">
      Ingresar
    </a>
  </div>
</Layout>

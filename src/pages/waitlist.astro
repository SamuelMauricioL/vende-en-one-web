---
import Layout from "@/layouts/Layout.astro";
import { AppProviders } from "@/components/AppProviders";
import { WaitlistLandingPage } from "@/components/waitlist-landing/waitlist-landing-page";
---

<Layout
  title="No pierdas oportunidades de venta en tus lives de TikTok — Live Leads"
  description="Mientras presentas, Live Leads lee el chat de tu TikTok Live y separa a quien solo mira de quien pregunta el precio o quiere comprar. Únete a la waitlist y entra en la próxima tanda."
>
  <AppProviders client:load>
    <div class="min-h-screen flex flex-col">
      <div class="flex-1">
        <WaitlistLandingPage client:load />
      </div>
    </div>
  </AppProviders>
</Layout>
